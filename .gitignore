# --- secrets: never commit ---
.env
.env.*
!.env.example

# --- python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- database ---
*.db
*.db-journal
*.sqlite3

# --- model / hf caches ---
# NB: scope these tightly. A bare `models/` rule would also ignore backend/app/models/.
.cache/
.hf_cache/

# --- node / vite ---
node_modules/
dist/
dist-ssr/
*.local
.vite/

# --- editors / os ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- local documentation ---
# Keep only the repository's root README public. Detailed runbooks and pitch material stay local.
*.md
!/README.md
docs/

# --- per-account Razorpay test artefacts (regenerate with data/backfill_razorpay_backing.py) ---
backend/data/razorpay_backing.json

# --- private real-dispute research data: never commit ---
# The only committed real-data-shaped records belong under data/examples/ and must be
# fictional/sanitized. Raw exports, normalized rows, splits, and trained artifacts stay
# local even after pseudonymization because free-text evidence can still be identifying.
backend/data/private/
backend/data/real/
backend/eval/artifacts/real/
backend/eval/real_runs/
backend/training/private/
backend/.demo-checks/
backend/eval/synthetic_win_gate_candidate.json
backend/eval/stress_runs/

# Tuning cache: regenerable via `python eval/tune_thresholds.py --build-cache`
backend/eval/.signal_cache.json
