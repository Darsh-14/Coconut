# --- Razorpay (REQUIRED) ---
# Test mode only. The app refuses to start if RAZORPAY_KEY_ID does not begin with rzp_test_.
# Dashboard -> switch to Test Mode -> Account & Settings -> API Keys -> Generate Key.
# Test keys are free and need no KYC.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Optional. Enables POST /webhooks/razorpay, which is how a completed Checkout payment
# promotes itself onto its dispute without anyone reloading a page. Left blank, the
# endpoint refuses every request -- it never accepts unsigned events, because that would
# be an unauthenticated write path into the queue.
# Dashboard -> Settings -> Webhooks -> create one -> copy the secret you set.
RAZORPAY_WEBHOOK_SECRET=

# --- Application ---
DATABASE_URL=sqlite:///./coconut.db
ASSUMED_REPRESENTMENT_COST_INR=1500

# --- LLM drafting (ALL OPTIONAL) ---
# Used only to rewrite the representment packet AFTER the decision is made. The decision
# itself is made by a local NLI model and never calls an LLM. With no key set, packets are
# produced by a deterministic template, and the whole app works.
#
# auto (default) prefers Gemini, then Anthropic, then the template.
# Set to gemini | anthropic | none to force one.
LLM_PROVIDER=auto

# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Left blank, a suitable model is discovered from the API at runtime.
GEMINI_MODEL=

# Optional, paid: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Hard ceiling on a drafting attempt, so a provider outage cannot hang a request.
# A 503 with default SDK backoff was measured retrying for 296s before giving up.
LLM_TIMEOUT_SECONDS=15
LLM_RETRY_ATTEMPTS=2
